diff --git a/CMakeLists.txt b/CMakeLists.txt
index f0660cd..be7765b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -57,15 +57,39 @@ endif()
 # ------------
 
 find_package(OpenSSL REQUIRED)
-find_package(unofficial-curlpp CONFIG REQUIRED)
-find_package(unofficial-inih CONFIG REQUIRED)
+find_package(curlpp CONFIG REQUIRED)
+if(NOT curlpp_FOUND)
+  find_package(unofficial-curlpp CONFIG REQUIRED)
+  set(curlpp_LIBRARIES unofficial::curlpp::curlpp)
+elseif(NOT curlpp_LIBRARIES)
+  # curlpp's own curlppConfig.cmake exports the imported target
+  # curlpp::curlpp and never sets curlpp_LIBRARIES. When that config is the
+  # one that wins -- it ships in $PREFIX/lib/cmake/curlpp, so it does --
+  # ${curlpp_LIBRARIES} expands to nothing here and libminiocpp.so gets
+  # linked against neither curlpp nor curl. Nothing complains: a shared
+  # object may keep undefined symbols, so the failure waits until something
+  # loads the library and dies on "undefined symbol:
+  # _ZTIN6curlpp12RuntimeErrorE".
+  #
+  # CURL must be found first: curlpp::curlpp names CURL::libcurl in its
+  # INTERFACE_LINK_LIBRARIES, and linking a target that references an
+  # undefined imported target is a generate-time error.
+  find_package(CURL REQUIRED)
+  set(curlpp_LIBRARIES curlpp::curlpp)
+endif()
+
+find_package(inih CONFIG REQUIRED)
+if(NOT inih_FOUND)
+  find_package(unofficial-inih CONFIG REQUIRED)
+  set(inih_LIBRARIES unofficial::inih::inireader)
+endif()
 find_package(nlohmann_json CONFIG REQUIRED)
 find_package(pugixml CONFIG REQUIRED)
 find_package(ZLIB REQUIRED)
 
 list(APPEND MINIO_CPP_LIBS
-  unofficial::curlpp::curlpp
-  unofficial::inih::inireader
+  ${curlpp_LIBRARIES}
+  ${inih_LIBRARIES}
   nlohmann_json::nlohmann_json
   pugixml
   OpenSSL::SSL OpenSSL::Crypto
@@ -208,7 +232,7 @@ if (MINIO_CPP_TEST)
   add_executable(tests tests/tests.cc)
   target_compile_features(tests PUBLIC cxx_std_${MINIO_CPP_STD})
   target_include_directories(tests PRIVATE ${CMAKE_CURRENT_LIST_DIR}/include)
-  target_link_libraries(tests miniocpp ${MINIO_CPP_LIBS})
+  target_link_libraries(tests miniocpp ${MINIO_CPP_LIBS} pthread)
 endif()
 
